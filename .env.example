# MongoDB Atlas connection string.
# Replace the example host and credentials only in your local .env.local file.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Database used by LeadDesk Mini.
MONGODB_DB_NAME=leaddesk

# Used only by `npm run db:seed-admin`. Choose a strong, unique password and
# keep the real values in an ignored local or deployment environment file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Used only by the trusted release verification command.
RELEASE_BASE_URL=https://your-production-host.example
